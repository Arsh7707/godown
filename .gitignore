# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# Extraction fixtures: real customer data stays local unless deliberately added
/fixtures/*
!/fixtures/README.md
!/fixtures/catalog.example.json
!/fixtures/example-*
/fixtures/results/

# Real company seed data (names, phone numbers)
/seed/*.local.json

# Local file storage in development
/.storage/

# Local throwaway browser-test scripts
/scripts/zz-*

# Browser tests
/.next-e2e/
/e2e/.state/
/playwright-report/
/test-results/
