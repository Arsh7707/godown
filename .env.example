# Postgres (Supabase or local)
DATABASE_URL=postgres://localhost:5432/order_book_dev

ANTHROPIC_API_KEY=
EXTRACTION_TIMEOUT_MS=45000

# Claude extraction. Typed text and voice transcripts go to the simple model;
# slip photos, and anything the simple model can't read, go to the complex one.
EXTRACTION_MODEL_SIMPLE=claude-haiku-4-5
EXTRACTION_MODEL_COMPLEX=claude-sonnet-5-5
# Optional effort (low | medium | high | xhigh | max). Leave SIMPLE empty for Haiku.
EXTRACTION_EFFORT_SIMPLE=
EXTRACTION_EFFORT_COMPLEX=low

# Speech-to-text (Sarvam AI)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
# unknown = auto-detect Hindi / Punjabi / English per note (or fix to hi-IN, pa-IN, en-IN)
SARVAM_LANGUAGE=unknown

# Login. SESSION_SECRET: 32+ random characters. OTP_DEV_MODE=true shows codes on
# screen instead of SMS (testing only); TEST_ACCESS_CODE is then required to log in.
SESSION_SECRET=
OTP_DEV_MODE=false
TEST_ACCESS_CODE=

